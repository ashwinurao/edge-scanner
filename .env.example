# Copy this file to .env and fill in your own values. .env is gitignored.

# Alpaca market data (https://alpaca.markets). Paper-trading keys work.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data provider: alpaca (default) or schwab. Any other provider can be added by
# implementing scanner/data/interface.py; see "Adding a data provider" in USER_GUIDE.md.
DATA_PROVIDER=alpaca

# Charles Schwab (only for DATA_PROVIDER=schwab). Create an app at
# https://developer.schwab.com, then log in once: python scripts/schwab_auth.py
# (the login expires after 7 days; run it again weekly).
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1
# Schwab streams real 1-minute bars for 300 symbols; past that the scanner builds bars from
# Schwab's quotes so the whole universe is covered. Set to 0 to scan only the first 300.
# SCHWAB_SYNTHETIC_BARS=1
# Share another app's Schwab login instead of signing in here (see "Running on a home server"
# in the README). The file is a schwab-py token file, read-only; the key is its Fernet key.
# SCHWAB_SHARED_TOKEN_FILE=
# SCHWAB_SHARED_TOKEN_KEY=
# SCHWAB_SHARED_APP_NAME=

# At startup the scanner asks GitHub once whether a newer release exists and says so in the
# dashboard. One anonymous request, nothing installed. Set to 0 to turn it off.
# UPDATE_CHECK=1

# The API answers only requests addressed to localhost, 127.0.0.1 or [::1] (and to the
# --host you start it with). To open the dashboard from another machine on your LAN with
# --host 0.0.0.0, list the names it will use, comma-separated. Anyone who can reach it can
# change your setups: there is no login.
# SCANNER_ALLOWED_HOSTS=192.168.1.20,trading-pc

# sip (default): the consolidated tape, needs a paid Alpaca market-data plan.
# iex: free, but a single exchange, so volume and RVOL read far lower and the
# volume-based setups fire much less.
ALPACA_FEED=sip

# When a running scanner rolls prior closes, ADV, ATR and levels forward to the new day,
# New York time (default 03:30, before the pre-market). off: only at startup.
# DAILY_REFRESH_ET=03:30

# Set to 0 to never open an Alpaca websocket (Alpaca allows one per account, so use this when
# another app streams on the same keys): 1-minute bars are then polled from REST every 5 seconds.
# ALPACA_STREAM=1

# The opening recorder (scanner/open_recorder.py): with OV picks on, it saves Alpaca's answers
# for the day's top picks and SPY from 09:29 to 09:36 ET to data/open_recorder/, for study.
# REST only, about 870 requests a day. Set to 0 to turn it off.
# OPEN_RECORDER=1

# News window: keyless per-symbol RSS feeds merged with Alpaca news.
# Comma-separated, any of: yahoo,nasdaq. Empty = Alpaca news only.
# NEWS_RSS_SOURCES=yahoo,nasdaq
