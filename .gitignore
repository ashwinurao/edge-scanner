# Secrets
.env

# Runtime data: caches, settings, setups, alert archives (all under data/)
/data/

# Runtime logs, written by the live scanner every session
logs/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Dashboard
dashboard-v2/node_modules/
dashboard-v2/dist/

# Tooling: local Claude Code state stays out; the shared plugin settings are tracked
.claude/*
!.claude/settings.json

# scratch artifacts (test output, screenshots, notes)
.logs/

# local databases (none ship with the project; a provider library may write one)
*.db
*.db-wal
*.db-shm

# Docker: compose's placeholder mounts when no shared Schwab login or OV picks module is set
/shared-schwab-unused/
/ov-picks-unused/
